<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur d'âge"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="32,40,32,32" Spacing="20">

            <!-- Titre -->
            <Label Text="Calculateur d'âge"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#1C1C1E"/>

            <BoxView HeightRequest="1" Color="#E5E5EA" Margin="0,0,0,4"/>

            <!-- Champ Nom -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Nom" FontSize="14" TextColor="#3C3C43"/>
                <Entry Text="{Binding Nom, Mode=TwoWay}"
                       Placeholder="Entrez votre nom"
                       PlaceholderColor="#C7C7CC"
                       TextColor="#1C1C1E"
                       BackgroundColor="#F2F2F7"
                       FontSize="16"/>
            </VerticalStackLayout>

            <!-- Champ Date -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Date de naissance" FontSize="14" TextColor="#3C3C43"/>
                <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"
                            TextColor="#1C1C1E"
                            BackgroundColor="#F2F2F7"
                            FontSize="16"/>
            </VerticalStackLayout>

            <!-- Boutons -->
            <Grid ColumnDefinitions="*,120" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Calculer"
                        Command="{Binding CalculerCommand}"
                        BackgroundColor="#007AFF"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"/>
                <Button Grid.Column="1"
                        Text="Effacer"
                        Command="{Binding EffacerCommand}"
                        BackgroundColor="#F2F2F7"
                        TextColor="#FF3B30"
                        FontSize="15"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"/>
            </Grid>

            <!-- Séparateur résultats -->
            <BoxView IsVisible="{Binding ResultatVisible}"
                     HeightRequest="1"
                     Color="#E5E5EA"
                     Margin="0,4"/>

            <!-- Résultats -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding ResultatVisible}">

                <Label Text="{Binding Resultat}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1C1C1E"/>

                <Label Text="{Binding Statut}"
                       FontSize="16"
                       TextColor="#3C3C43"/>

                <Label Text="{Binding JoursAvantAnniversaire}"
                       FontSize="15"
                       TextColor="#8E8E93"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
